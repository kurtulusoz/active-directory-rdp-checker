# Active Directory bağlantısı
AD_USERNAME=administrator
AD_PASSWORD=PASSWORD
AD_DOMAIN=domain.local
AD_SERVER=192.0.2.10
AD_NETBIOS=DOMAIN

# LDAP/WinRM sorgu parametreleri
TIMEOUT_SECONDS=5
TARGET_USER=check_remote_user

# Hariç tutulacak bilgisayarlar (boşlukla ayır)
EXCLUDE_COMPUTERS=HOST1 HOST2 NASX

# OU listesi (her biri ayrı tırnak içinde, boşlukla ayır)
OUs="OU=Test1Clients,DC=test,DC=local" "OU=Test2Clients,DC=test,DC=local"
